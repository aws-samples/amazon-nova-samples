        {"field": "contact_material", "label": "Contact material", "rule": "match", "required_from_user": false},
        {"field": "outgassing_cvcm_pct", "label": "Outgassing CVCM (%)", "rule": "candidate_lte_reference_within_pct", "tolerance_pct": 0, "required_from_user": false},
        {"field": "mating_cycles", "label": "Rated mating cycles", "rule": "candidate_gte_reference", "required_from_user": false},
        {"field": "qual_standard", "label": "Qualification standard", "rule": "qual_review", "required_from_user": false}
