        {"field": "voltage_vmp", "label": "Voltage at max power (V)", "rule": "match", "required_from_user": true},
        {"field": "operating_temp_c", "label": "Operating temperature range (°C)", "rule": "range_envelops_required", "required_from_user": true},
        {"field": "radiation_tolerance_krad", "label": "Radiation tolerance (krad)", "rule": "candidate_gte_required", "required_from_user": true},
        {"field": "efficiency_pct", "label": "Cell efficiency (%)", "rule": "candidate_gte_reference", "required_from_user": false},
        {"field": "mass_g", "label": "Mass (g)", "rule": "candidate_lte_reference_within_pct", "tolerance_pct": 20, "required_from_user": false},
