        {"field": "voltage_v", "label": "Supply voltage (V)", "rule": "match", "required_from_user": true},
        {"field": "power_w", "label": "Power draw (W)", "rule": "candidate_lte_reference_within_pct", "tolerance_pct": 15, "required_from_user": true},
